generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model VehicleListing {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  title        String
  make         String
  location     String?
  listingUrl   String?
  mileage      String
  engine       String
  transmission String
  fuel         String
  price        String
  details      Json?
  images       Json
  favorites    VehicleFavorite[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([make])
  @@index([createdAt])
}

model UserProfile {
  id         String            @id @db.Uuid
  fullName   String            @map("full_name")
  avatarUrl  String?           @map("avatar_url")
  avatarPath String?           @map("avatar_path")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  favorites  VehicleFavorite[]

  @@map("user_profiles")
}

model VehicleFavorite {
  userId    String         @db.Uuid @map("user_id")
  listingSlug String       @map("listing_slug")
  createdAt DateTime       @default(now()) @map("created_at")
  user      UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   VehicleListing @relation(fields: [listingSlug], references: [slug], onDelete: Cascade)

  @@id([userId, listingSlug])
  @@index([listingSlug])
  @@map("vehicle_favorites")
}
